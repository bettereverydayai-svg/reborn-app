rules_version = '2';
// Reborn Rising: account backup, crash reports and public app config.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // One backup per account: users/{uid} plus optional users/{uid}/chunks/{i}.
    // Only the signed-in owner can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /chunks/{chunk} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Crash reports: anyone running the app may add one, nobody can read, change or delete
    // them from the app (read them in the Firebase console).
    match /crashes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'version', 'ua', 'time', 'uid', 'where'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 4096
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 400
        && request.resource.data.time is int
        && (request.resource.data.uid == null || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && request.resource.data.where is string && request.resource.data.where.size() <= 20;
      allow read, update, delete: if false;
    }

    // In-app feedback: anyone running the app (signed in or not) may add one, nobody can read,
    // change or delete them from the app (read them in the Firebase console).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'contact', 'version', 'code', 'bundle', 'platform', 'ua', 'screen', 'lang', 'uid', 'time'])
        && request.resource.data.type in ['bug', 'idea', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.code is int
        && request.resource.data.bundle is string && request.resource.data.bundle.size() <= 40
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 400
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 40
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && (request.resource.data.uid == null || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && request.resource.data.time is int;
      allow read, update, delete: if false;
    }

    // App config, e.g. config/latest for the in-app update notice. Anyone may read it;
    // only the Firebase console (or Admin SDK) can change it.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
